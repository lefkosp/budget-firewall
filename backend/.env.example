# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
PORT=3001
MONGODB_URI=mongodb://localhost:27017/budget-firewall
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Auth (Security Tier 2) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

# --- Background sync cron (Phase 5) ---
# Required once the cron route is in use; sent as the X-Cron-Secret header.
CRON_SECRET=

# --- Open Banking provider (Phase 5) ---
# "mock" (default, no credentials needed) or "nordigen" (real GoCardless
# Bank Account Data API — see backend/MIGRATION_TO_REAL_OPEN_BANKING.md).
OPEN_BANKING_PROVIDER=mock
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=
NORDIGEN_REDIRECT_URI=http://localhost:3001/api/banking/callback
NORDIGEN_API_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
NORDIGEN_INSTITUTION_ID=REVOLUT_REVOGB21
